# =============================================================================
# Firebase — Firestore (Database)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Copy the values from the downloaded service account JSON file.
# =============================================================================

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the "private_key" value from the JSON, keeping the literal \n escapes.
# In .env.local it must be wrapped in double quotes on a single line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...your key...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# Vercel Blob (Storage for file uploads)
# Vercel Dashboard → Project → Storage → Blob
# When deploying to Vercel with OIDC, BLOB_STORE_ID is auto-injected.
# For local development or non-Vercel hosts, copy from Vercel Project Settings.
# =============================================================================

# Store ID (OIDC, preferred): enables short-lived Vercel-managed credentials.
# Set this in Vercel Dashboard → Storage → Blob → Connect to Project.
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxxx

# Read/write token (fallback): long-lived token for non-Vercel hosts or local dev.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Webhook public key: used only if you process Blob webhooks (optional).
# BLOB_WEBHOOK_PUBLIC_KEY=whpk_xxxxxxxxxxxxxxxxx

# Optional: hint for the access mode if you already know it.
# BLOB_ACCESS=private

# =============================================================================
# Admin login (CHANGE THESE before deploying publicly)
# =============================================================================

ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password
JWT_SECRET=generate-a-long-random-string-here

# =============================================================================
# SEO
# =============================================================================

# Public site origin used for canonical URLs, hreflang and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
